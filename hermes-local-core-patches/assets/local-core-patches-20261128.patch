+# Markdown code is documentation, not a directive: cron prompts routinely paste runbook/skill
+# excerpts whose fenced blocks *describe* commands (`visudo`, `rm -rf /`, `cat .env`). Strip fenced
+# blocks and inline code before the strict scan so the tripwire fires on prose only.
+# Local patch (not upstream) — see skills/.archive/hermes-webui-ops/references/local-core-patches.md.
+_FENCED_CODE_RE = re.compile(r"```.*?```|~~~.*?~~~", re.DOTALL)
+_INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
+
+
+def _strip_doc_code_blocks(prompt: str) -> str:
+    """Drop markdown fenced/inline code so pasted docs don't trip the strict prompt scan."""
+    return _INLINE_CODE_RE.sub(" ", _FENCED_CODE_RE.sub(" ", prompt))
+
+
